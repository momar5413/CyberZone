{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CyberZone",
  "version": "../package.json",
  "identifier": "com.momar5413.cyberzone",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:desktop-web",
    "beforeBuildCommand": "npm run build:desktop-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CyberZone",
        "width": 1360,
        "height": 860,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#141518"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CyberZone",
    "category": "Business",
    "shortDescription": "إدارة صالة الألعاب",
    "longDescription": "مؤقتات الأجهزة، الحجوزات، البوفيه، الصندوق والورديات، الإيصالات والتقارير لصالات البلايستيشن والكمبيوتر.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
